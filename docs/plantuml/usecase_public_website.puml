@startuml usecase_public_website
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam roundCorner 10
skinparam shadowing true
skinparam packageStyle rectangle

skinparam actor {
    BackgroundColor #F8FAFC
    BorderColor #334155
    FontColor #0F172A
    FontSize 13
}

skinparam usecase {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
    FontColor #1E3A8A
    FontSize 12
    ArrowColor #475569
    ArrowFontSize 11
}

title **Diagram Use Case - Website Publik & Customer Journey**\n(queen-transport.com)

left to right direction

actor "Pengunjung Web\n(Visitor / Guest)" as Visitor << Human >>
actor "Calon Pelanggan\n(Customer)" as Customer << Human >>
actor "Admin WhatsApp / CS" as CS << Human / External >>
actor "Mesin Pencari\n(Search Engine Bot)" as Crawler << External System >>

Visitor <|-- Customer : <<generalization>>

rectangle "Website Publik (Front-End)" {

    package "Beranda & Interaksi Media" {
        usecase "Melihat Beranda (Landing Page)" as UC_Home
        usecase "Menonton Video Hero Showcase" as UC_Video
        usecase "Mengatur Audio Video (Mute/Unmute)" as UC_AudioToggle
        usecase "Melihat Informasi Kontak & Alamat" as UC_Kontak
    }

    package "Katalog & Reservasi Armada" {
        usecase "Menjelajahi Katalog Armada Premium" as UC_ArmadaList
        usecase "Melihat Detail Spesifikasi & Fitur VIP" as UC_ArmadaDetail
        usecase "Melihat Tarif Sewa & Fasilitas" as UC_ArmadaTarif
        usecase "Melakukan Reservasi via WhatsApp" as UC_BookWA
        usecase "Generate Template Pesan Otomatis\n(Mobil, Durasi, Tanggal)" as UC_GenWAMsg
    }

    package "Galeri & Reputasi Klien" {
        usecase "Melihat Showcase Dokumentasi Layanan" as UC_Galeri
        usecase "Melihat Portofolio Klien Korporat & VIP" as UC_Pelanggan
    }

    package "Artikel & Blog SEO" {
        usecase "Membaca Daftar Artikel Blog" as UC_BlogList
        usecase "Mencari Artikel (Search)" as UC_BlogSearch
        usecase "Memfilter Artikel per Kategori / Tag" as UC_BlogFilter
        usecase "Membaca Isi Lengkap Artikel\n(Permalink /{year}/{month}/{slug})" as UC_BlogDetail
        usecase "Bagikan Artikel ke Media Sosial" as UC_BlogShare
    }

    package "Indexing Mesin Pencari" {
        usecase "Mengakses File Sitemap XML\n(/sitemap.xml)" as UC_Sitemap
        usecase "Crawling Struktur URL SEO-Friendly" as UC_CrawlSEO
    }
}

' Relasi Pengunjung Umum
Visitor --> UC_Home
Visitor --> UC_ArmadaList
Visitor --> UC_Galeri
Visitor --> UC_Pelanggan
Visitor --> UC_BlogList
Visitor --> UC_Kontak

' Hubungan Use Case Beranda
UC_Video ..> UC_Home : <<include>>
UC_AudioToggle ..> UC_Video : <<extend>>

' Hubungan Use Case Armada & Reservasi
UC_ArmadaDetail ..> UC_ArmadaList : <<extend>>
UC_ArmadaTarif ..> UC_ArmadaDetail : <<include>>

Customer --> UC_BookWA
UC_BookWA ..> UC_ArmadaDetail : <<extend>>
UC_BookWA ..> UC_GenWAMsg : <<include>>
UC_BookWA --> CS : "Mengarahkan percakapan WhatsApp"

' Hubungan Use Case Blog
UC_BlogSearch ..> UC_BlogList : <<extend>>
UC_BlogFilter ..> UC_BlogList : <<extend>>
UC_BlogDetail ..> UC_BlogList : <<extend>>
UC_BlogShare ..> UC_BlogDetail : <<extend>>

' Relasi Mesin Pencari
Crawler --> UC_Sitemap
Crawler --> UC_CrawlSEO
UC_CrawlSEO ..> UC_BlogDetail : <<include>>
UC_CrawlSEO ..> UC_ArmadaDetail : <<include>>

@enduml
